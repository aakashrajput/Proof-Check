# --- required ---
ADMIN_PASSWORD=change-me
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash   # or gemini-2.5-flash-lite for lower cost

# --- SproutGigs auto-rating (optional) ---
SG_USER_ID=                # your SproutGigs user id
SG_API_SECRET=             # Account Settings -> API secret
SG_UNMATCHED_ACTION=skip   # skip | revise | not_ok  (what to do with proofs that have no valid payout code)
CRON_SECRET=               # any random string; protects /api/sproutgigs/sync for cron/poller

# --- optional ---
TEXT_MAX_AGE_HOURS=24      # reject "Copy debug info" text older than this (0 = disable)
VERIFY_RATE_PER_MIN=20     # per-IP submissions per minute on /api/verify (0 = unlimited)
YOUTUBE_API_KEY=           # resolves channel @handle; falls back to oEmbed (title + channel name) if blank
DATABASE_URL=file:./data/proofcheck.db       # local SQLite. On Vercel use Turso: libsql://xxx.turso.io
DATABASE_AUTH_TOKEN=
# GEMINI_MOCK_JSON={"has_stats_panel":true,...}  # tests only: bypasses Gemini
